# PostgreSQL connection string (also stores login sessions in the express_sessions table)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Server port
PORT=4000

# Frontend URL for CORS (required in production — must match the site users open)
# Example: FRONTEND_URL=https://holderforge.io
FRONTEND_URL=http://localhost:5173

# Environment
NODE_ENV=development

# Session secret for Express sessions (set a strong random string in real .env)
SESSION_SECRET=change-me-in-production

# Google OAuth credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Optional client URL alias (often same as FRONTEND_URL)
CLIENT_URL=http://localhost:5173

# ─── RPC Endpoints (replace with your own provider keys) ───────────────────────
ALCHEMY_RPC_URL=https://bnb-mainnet.g.alchemy.com/v2/your-key
BSC_TESTNET_RPC_URL=https://bnb-testnet.g.alchemy.com/v2/your-key
FALLBACK_RPC_1=https://bsc-dataseed1.binance.org
FALLBACK_RPC_2=https://bsc-dataseed2.binance.org

# ─── Optional opBNB support ────────────────────────────────────────────────────
OPBNB_TOKEN_ADDRESS=
OPBNB_MULTISENDER_ADDRESS=

# ─── Missing from the original example (used by the existing app) ─────────────
COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=
BSC_TESTNET_FALLBACK_RPC_1=https://data-seed-prebsc-1-s1.binance.org:8545
BSC_TESTNET_FALLBACK_RPC_2=https://data-seed-prebsc-2-s1.binance.org:8545
# A local Postgres without TLS needs ?sslmode=disable appended to DATABASE_URL.

# ─── Managed Wallets (admin-only; on by default) ───────────────────────────────
# Admins see the feature by default. It works once the server has
# WALLET_ENCRYPTION_KEY and the migration (`node dist/migrate.js` in the pod);
# until then the admin pages show a setup checklist.
MANAGED_WALLETS_ENABLED=               # on by default for ADMIN users; set to false to turn the feature off
WALLET_ENCRYPTION_KEY=                 # base64 32 bytes: npm run managed:gen-key (back it up offline)
# Every backend sharing one database must use the SAME key. A laptop pointed at
# the production database must also set both switches below to false, so only
# the server sends transfers and scans deposits.
MANAGED_INDEXER_ENABLED=true           # run the deposit scanner in this process
MANAGED_WORKER_ENABLED=true            # run the transfer worker (signs and broadcasts) in this process
MANAGED_INDEXER_INTERVAL_MS=30000
MANAGED_INDEXER_CONFIRMATIONS=15
MANAGED_INDEXER_BLOCK_CHUNK=1000
MANAGED_INDEXER_ADDRESS_CHUNK=500
MANAGED_FULL_REFRESH_MS=600000
MANAGED_WORKER_INTERVAL_MS=3000
MANAGED_MAX_WALLETS_PER_POOL=10000
MANAGED_MIN_GAS_PRICE_GWEI=0.1
MANAGED_MAX_GAS_PRICE_GWEI=5
MANAGED_MAX_GAS_LIMIT=300000
MANAGED_TOPUP_BUFFER_WEI=100000000000000   # 0.0001 BNB
MANAGED_MAX_ATTEMPTS=3
MANAGED_TX_TIMEOUT_MS=180000
MANAGED_VIEW_RATE_LIMIT_PER_MIN=60
MULTICALL3_ADDRESS=0xcA11bde05977b3631167028862bE2a173976CA11
